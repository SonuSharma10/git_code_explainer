SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string for psycopg
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_repo_explainer

# Fernet symmetric encryption key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Google Gemini API Key & Model settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ALLOW_SYSTEM_GEMINI_FALLBACK=True

# Optional GitHub Personal Access Token (for higher rate limits)
GITHUB_TOKEN=

# Maximum past conversation IDs to list in the UI history
PAST_CONVERSATION_LIMIT=10

# Redis Connection URL (Local or Cloud Redis) for JWT validation and caching
REDIS_URL=redis://default:<password>@<host>:<port>
